@@ -0,0 +1,30 @@
+'use strict';
+const {AsyncLocalStorage}=require('node:async_hooks');
+const {randomUUID}=require('node:crypto');
+const storage=new AsyncLocalStorage();
+const BACKEND_MS=18500,WORKER_MS=7500,WRITE_RESERVE_MS=1500;
+function current(){return storage.getStore();}
+function check(){const c=current();if(c){if(Date.now()>=c.endsAt&&!c.signal.aborted)c.controller.abort(new DOMException('Live price request deadline exceeded','TimeoutError'));c.signal.throwIfAborted();}}
+function remaining(){check();return current()?Math.max(1,current().endsAt-Date.now()):BACKEND_MS;}
+function options(extra={}){
+ check();
+ if(!current())return extra;
+ // withTransaction owns the aggregate CSOT; driver forbids per-operation overrides there.
+ return {...extra,signal:current().signal,...(extra.session?.inTransaction()?{}:{timeoutMS:remaining()})};
+}
+async function wait(promise){
+ const c=current();if(!c)return promise;
+ check();let abort;
+ const stopped=new Promise((_,reject)=>{abort=()=>reject(c.signal.reason);c.signal.addEventListener('abort',abort,{once:true});});
+ try{return await Promise.race([promise,stopped]);}finally{c.signal.removeEventListener('abort',abort);}
+}
+function workerSignal(){check();const s=AbortSignal.timeout(Math.min(WORKER_MS,Math.max(1,remaining()-WRITE_RESERVE_MS)));return current()?AbortSignal.any([s,current().signal]):s;}
+async function run(fn,{timeoutMS=BACKEND_MS,signal}={}){
+ if(current())return fn();
+ const controller=new AbortController(),c={id:randomUUID(),controller,signal:controller.signal,endsAt:Date.now()+timeoutMS};
+ const stop=()=>controller.abort(signal.reason||new DOMException('Client disconnected','AbortError'));
+ if(signal){if(signal.aborted)stop();else signal.addEventListener('abort',stop,{once:true});}
+ const timer=setTimeout(()=>controller.abort(new DOMException('Live price request deadline exceeded','TimeoutError')),timeoutMS);
+ try{return await storage.run(c,fn);}finally{clearTimeout(timer);signal?.removeEventListener('abort',stop);}
+}
+module.exports={current,check,remaining,options,wait,workerSignal,run,BACKEND_MS,WORKER_MS,WRITE_RESERVE_MS};
