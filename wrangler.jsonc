{
  "name": "trustfolio-live-price-worker",
  "main": "index.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": [
      "5 */6 * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR_STATE",
        "class_name": "PriceMonitorState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_trustfolio_monitor_sqlite",
      "new_sqlite_classes": [
        "PriceMonitorState"
      ]
    }
  ],
  "previews": {
    "browser": {
      "binding": "BROWSER"
    },
    "durable_objects": {
      "bindings": [
        {
          "name": "MONITOR_STATE",
          "class_name": "PriceMonitorState"
        }
      ]
    }
  }
}
